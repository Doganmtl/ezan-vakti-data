 "gunler": [
  {
   "t": "2026-11-21",
   "g": 325,
   "ayet": {
    "m": "Siz ancak işlediklerinizin karşılığı ile cezalandırılırsınız. Ancak Allah'ın halis kulları başka. İşte onlar için belli bir rızık, meyveler vardır. Onlar ikram gören kimselerdir.",
    "k": "(Saffât, 37/39-42)"
   },
   "hadis": {
    "m": "Kim kötü işlerden ve Allah’a karşı gelmekten sakınarak hac yaparsa, günahlardan temizlenerek anasından doğduğu gibi tertemiz hâle gelir",
    "k": "(Buhârî, “Hac”, 4)"
   },
   "dua": {
    "m": "Ya Rabbi! Yalnız senin rab oluşunu kabul eder ve ancak sana boyun eğeriz. Sana itaat etmekle iç huzuru ve gönül ferahlığı buluruz. Çünkü bütün korku ve ümidimizin ilk ve son kaynağı yalnız sensin. Sen korku vermezsen korku yok. Sen ümit vermezsen ümit yo…",
    "k": "(Elmalılı Hamdi Yazır)"
   }
  },
  {
   "t": "2026-11-22",
   "g": 326,
   "ayet": {
    "m": "Âyetlerimizi geçersiz kılmak için yarışırcasına çaba harcayanlar var ya; işte onlar için elem dolu, çok kötü bir azap vardır.",
    "k": "(Seb'e, 34/5)"
   },
   "hadis": {
    "m": "Kim Müslüman kardeşinin onurunu savunursa Allah da kıyamet gününde onun yüzünden cehennem ateşini savar.",
    "k": "(Tirmizî, \"Birr\", 20)"
   },
   "dua": {
    "m": "Yarattığı şeylerin kötülüğünden, karanlığı çöktüğü zaman gecenin kötülüğünden, düğümlere üfleyenlerin kötülüğünden, haset ettiği zaman hasetçinin kötülüğünden, sabah aydınlığının Rabbine sığınırım.",
    "k": "(Felak, 113/1-5)"
   }
  },
  {
   "t": "2026-11-23",
   "g": 327,
   "ayet": {
    "m": "Sizin için belirlenen bir gün vardır ki, ondan ne bir saat geri kalabilirsiniz, ne de ileri geçebilirsiniz.",
    "k": "(Seb'e, 34/30)"
   },
   "hadis": {
    "m": "Kimin üzerinde din kardeşinin ırzı, namusu veya malıyla ilgili bir hak varsa, altın ve gümüşün geçmediği hesap günü gelmeden helalleşsin. Aksi takdirde, yaptığı haksızlık ölçüsünde, iyi amellerinden alınıp hak sahibine verilir. İyiliği yoksa hak sahibin günahından alınıp haksızlık eden kimseye yüklenir.",
    "k": "( Buharî, \"Mezalim\",210; \"Rikak\",48)"
   },
   "dua": {
    "m": "\"Yavrularımıza, hayırlı kısmetler, başarı, huzur, bereket ve sağlık içinde bir ömür lütfeyle! Onları her türlü kötülüklerden ve zararlı alışkanlıklardan muhafaza eyle Allah’ım!",
    "k": ""
   }
  },
  {
   "t": "2026-11-24",
   "g": 328,
   "ayet": {
    "m": "Suçlular Rablerinin huzurunda boyunlarını büküp, ‘Rabbimiz! (Gerçeği) gördük ve işittik. Artık şimdi bizi (dünyaya) döndür ki, salih amel işleyelim. Biz artık kesin olarak inanmaktayız’, dedikleri vakit (onları) bir görsen!",
    "k": "(Secde, 32/12)"
   },
   "hadis": {
    "m": "Kişi, -kıyamet günü- sevdiği kimse ile beraberdir.",
    "k": "(Buharî, “Edeb”, 96; Müslim, “Birr”, 165)"
   },
   "dua": {
    "m": "Yüce Rabbim! Bizleri işitip akleden, düşünüp kavrayan, adaletle tedbir alan kullarından eyle!",
    "k": ""
   }
  },
  {
   "t": "2026-11-25",
   "g": 329,
   "ayet": {
    "m": "Hiç Mü'min (İman etmiş kimse) fasık (günaha batmış kimse) gibi olur mu? Bunlar elbette eşit değildirler.\"",
    "k": "(Secde, 32/18)"
   },
   "hadis": {
    "m": "Kişinin kalbi doğru olmadıkça imanı doğru olmaz. Dili doğru olmadıkça da kalbi doğru olmaz. Kötülüğünden komşusu emin olmadıkça kişi cennete giremez.",
    "k": "(Ahmed b. Hanbel, Müsned, III /198)"
   },
   "dua": {
    "m": "Zalimlerin baskı ve zulmünden, hâinlerin hile ve hıyanetinden, kıskançların hasedinden bizleri muhafaza eyle Allah’ım!",
    "k": ""
   }
  },
  {
   "t": "2026-11-26",
   "g": 330,
   "ayet": {
    "m": "İman edip salih amel işleyenlere gelince, onlar için, yapmakta olduklarına karşılık bir mükafat olarak Me'vâ cennetleri vardır.",
    "k": "(Secde, 32/19)"
   },
   "hadis": {
    "m": "Kişiyi ölürken üç şey uğurlar: Sevdikleri, malı ve yaptıkları. İlk ikisi geri döner ve o yaptıkları ile baş başa kalır.",
    "k": "(Buharî, “Rikak”, 42; Müslim, “Zühd”, 5)"
   },
   "dua": {
    "m": "…Allahım! Nefsime takvasını (günahlardan sakınma duygusu) ver ve onu (her türlü günahtan) temizle, Sen temizleyenlerin en hayırlısısın. Onun koruyucusu ve efendisi de sensin...",
    "k": "(Müslim, \"Dua\", 73)"
   }
  },
  {
   "t": "2026-11-27",
   "g": 331,
   "ayet": {
    "m": "Ölçüyü tam yapın. Eksik verenlerden olmayın.\" \"Doğru terazi ile tartın.\" \"İnsanların mallarını ve haklarını eksiltmeyin. Yeryüzünde bozgunculuk yaparak karışıklık çıkarmayın.",
    "k": "(Şu'arâ, 26/181-183)"
   },
   "hadis": {
    "m": "Kul, bir günah işlediği zaman kalbinde siyah bir leke oluşur. Günahı bırakıp tövbe ederse kalbi arınır",
    "k": "(Müslim, “İman”, 231)"
   },
   "dua": {
    "m": "Bir vücudun uzuvları gibi olabilmeyi, kardeşlerimizin acısını da sevincini de yüreğimizde hissedebilmeyi nasip eyle Allah’ım.",
    "k": ""
   }
  },
  {
   "t": "2026-11-28",
   "g": 332,
   "ayet": {
    "m": "O gün ki ne mal fayda verir ne oğullar! Allah’a arınmış bir kalp ile gelen başka.",
    "k": "(Şu'arâ, 26/88-89)"
   },
   "hadis": {
    "m": "Kulun Rabbine en yakın olduğu (an) secde hâlidir.Öyleyse (secdede iken) çokça dua ediniz.",
    "k": "(Müslim, \"Salât\", 215)"
   },
   "dua": {
    "m": "Mümin kardeşlerimizin halleriyle hallenebilmeyi, dertleriyle dertlenebilmeyi, acılarını acımız, sevinçlerini sevincimiz bilmeyi nasip eyle Allah’ım.",
    "k": ""
   }
